# SALIN ke .env (chmod 600 .env). JANGAN COMMIT .env. Lihat SECURITY.md.
POSTGRES_USER=academic
POSTGRES_PASSWORD=change_me_32char_min
POSTGRES_DB=academic_mvp
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me_32char_min
S3_BUCKET=academic-datasets
S3_REGION=us-east-1

JWT_SECRET=change_me_64char_min_generate_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

BACKEND_CORS_ORIGINS=http://localhost:3000
SOFTWARE_VERSION=0.1.0+mvp
MAX_UPLOAD_MB=50
ENV=dev
COOKIE_SECURE=false
# Prod WAJIB generate sendiri (openssl rand -base64 32) + JANGAN commit .env
OAUTH_ENCRYPTION_KEY=
# Login dengan Google (Google Cloud OAuth client, lihat docs/social-login.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Domain scraping yang diizinkan (koma); kosong = tolak semua (default aman)
SCRAPER_ALLOWLIST=en.wikipedia.org,wikipedia.org,docs.google.com,spreadsheets.google.com,github.com,raw.githubusercontent.com,httpbin.org,r.jina.ai
